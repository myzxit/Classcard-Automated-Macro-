<?xml version="1.0" encoding="utf-8"?>
<!--
  다크 모드 팔레트.
  values/colors.xml 과 '같은 이름'만 재정의하면 레이아웃/코드를 하나도 안 고쳐도
  시스템이 알아서 바꿔 끼운다 (테마가 DayNight 이므로).
-->
<resources>
    <!-- 배경 / 표면 -->
    <color name="bg">#FF0F1115</color>
    <color name="surface">#FF171A21</color>
    <color name="surface_alt">#FF1F232B</color>
    <color name="border">#FF2A2F3A</color>

    <!-- 글자 -->
    <color name="text_primary">#FFE5E7EB</color>
    <color name="text_secondary">#FF9CA3AF</color>
    <color name="text_tertiary">#FF6B7280</color>

    <!-- 포인트 -->
    <color name="primary">#FF3B82F6</color>
    <color name="primary_dark">#FF93C5FD</color>
    <color name="primary_soft">#FF17233A</color>
    <color name="primary_border">#FF3B82F6</color>

    <!-- 상태 칩 -->
    <color name="chip_running_bg">#FF14532D</color>
    <color name="chip_running_fg">#FF86EFAC</color>
    <color name="chip_ready_bg">#FF1E3A8A</color>
    <color name="chip_ready_fg">#FF93C5FD</color>
    <color name="chip_error_bg">#FF7F1D1D</color>
    <color name="chip_error_fg">#FFFCA5A5</color>
    <color name="chip_off_bg">#FF262B33</color>
    <color name="chip_off_fg">#FF9CA3AF</color>

    <!-- 위험(중지) -->
    <color name="danger">#FFF87171</color>
    <color name="danger_button">#FFDC2626</color>
    <color name="danger_button_pressed">#FFB91C1C</color>
    <color name="danger_soft">#FF2A1616</color>
    <color name="danger_border">#FF7F1D1D</color>

    <!-- 로그 콘솔 (라이트에서도 어둡지만 배경과 더 구분되게) -->
    <color name="log_bg">#FF0B0D11</color>
    <color name="log_text">#FFE5E7EB</color>
    <color name="log_dim">#FF9CA3AF</color>
    <color name="log_green">#FF4ADE80</color>
    <color name="log_red">#FFF87171</color>
    <color name="log_blue">#FF60A5FA</color>
    <color name="log_yellow">#FFFBBF24</color>
</resources>
