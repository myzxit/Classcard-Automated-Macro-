<?xml version="1.0" encoding="utf-8"?>
<!--
  다크 모드 팔레트.
  values/colors.xml 과 '같은 이름'만 재정의하면 레이아웃/코드를 하나도 안 고쳐도
  시스템이 알아서 바꿔 끼운다 (테마가 DayNight 이므로).
-->
<resources>
    <!-- 배경 / 표면 -->
    <color name="bg">#FF0B0A2A</color>
    <color name="surface">#BD161236</color>
    <color name="surface_alt">#992C2460</color>
    <color name="border">#38BEA0FF</color>

    <!-- 글자 -->
    <color name="text_primary">#FFEFE9FF</color>
    <color name="text_secondary">#FFB8ADDE</color>
    <color name="text_tertiary">#FF8A7FB5</color>

    <!-- 포인트 -->
    <color name="primary">#FF8B5CF6</color>
    <color name="primary_dark">#FFC4B5FD</color>
    <color name="primary_soft">#3D8B5CF6</color>
    <color name="primary_border">#FFA78BFA</color>

    <!-- 상태 칩 -->
    <color name="chip_running_bg">#3834D399</color>
    <color name="chip_running_fg">#FF86EFAC</color>
    <color name="chip_ready_bg">#4D8B5CF6</color>
    <color name="chip_ready_fg">#FFD9CCFF</color>
    <color name="chip_error_bg">#38FB7185</color>
    <color name="chip_error_fg">#FFFDA4AF</color>
    <color name="chip_off_bg">#14FFFFFF</color>
    <color name="chip_off_fg">#FFB8ADDE</color>

    <!-- 위험(중지) -->
    <color name="danger">#FFFB7185</color>
    <color name="danger_button">#FFE11D48</color>
    <color name="danger_button_pressed">#FFBE123C</color>
    <color name="danger_soft">#FF2A1616</color>
    <color name="danger_border">#FF7F1D1D</color>

    <!-- 로그 콘솔 (라이트에서도 어둡지만 배경과 더 구분되게) -->
    <color name="log_bg">#DB08061A</color>
    <color name="log_text">#FFE5E7EB</color>
    <color name="log_dim">#FF9CA3AF</color>
    <color name="log_green">#FF4ADE80</color>
    <color name="log_red">#FFF87171</color>
    <color name="log_blue">#FF60A5FA</color>
    <color name="log_yellow">#FFFBBF24</color>
    <color name="accent">#FFF472B6</color>
